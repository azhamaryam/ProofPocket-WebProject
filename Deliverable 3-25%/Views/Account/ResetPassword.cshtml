@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card">

    <h2 class="text-center">Reset Password</h2>
    <p class="text-center mb-4">Choose a new password for your account.</p>

    <form asp-action="ResetPassword" method="post">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <input type="hidden" asp-for="Token">

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" readonly>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="Enter a new password" autocomplete="new-password">
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your new password" autocomplete="new-password">
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Reset Password</button>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
