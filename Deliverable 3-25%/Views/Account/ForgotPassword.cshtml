@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">

    <h2 class="text-center">Forgot Password?</h2>
    <p class="text-center mb-4">Enter your email address and we'll help you reset your password.</p>

    <form asp-action="ForgotPassword" method="post">

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" autocomplete="username">
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>

    </form>

    <p class="text-center mt-4 mb-0">
        Remembered it?
        <a asp-action="Login" class="auth-link">Back to Login</a>
    </p>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
