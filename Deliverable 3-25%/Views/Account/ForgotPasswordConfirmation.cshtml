@{
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-card text-center">

    <h2>Check Your Email</h2>
    <p class="mb-3">
        If an account exists for that email address, a password reset link has been sent.
    </p>

    @if (TempData["ResetLink"] is string resetLink)
    {
        <div class="reset-link-box">
            <strong>Development mode:</strong> no email service is configured, so use this link instead.<br>
            <a href="@resetLink" class="auth-link">@resetLink</a>
        </div>
    }

    <a asp-action="Login" class="btn btn-primary w-100 mt-4">Back to Login</a>

</div>
