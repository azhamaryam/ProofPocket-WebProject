<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - ProofPocket</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ProofPocket</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">
                <div class="navbar-nav ms-auto align-items-lg-center">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-lg-3 mt-2 mt-lg-0">
                            <button type="submit" class="btn btn-primary">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-primary ms-lg-3 mt-2 mt-lg-0" asp-controller="Account" asp-action="Register">Get Started</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <partial name="_Alerts" />

    @RenderBody()

    <!-- Footer -->
    <footer class="text-center py-4">
        © @DateTime.Now.Year ProofPocket. All rights reserved.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
