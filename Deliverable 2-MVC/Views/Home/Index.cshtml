@{
    ViewData["Title"] = "Home";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("Admin");
}

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <h1>Keep Every Warranty in Your Pocket.</h1>

                <p>
                    Manage your product warranties in one place.
                    Keep track of your purchases, warranty periods,
                    and expiry dates without the hassle of paperwork.
                </p>

                <div class="mt-4">
                    @if (signedIn)
                    {
                        if (isAdmin)
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-primary me-2">Go to Dashboard</a>
                        }
                        else
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary me-2">Go to Dashboard</a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary me-2">Create Account</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Login</a>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-card">

                    <h4 class="mb-4">Your Warranty Organizer</h4>

                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 feature-lavender">
                        <div>
                            <h6 class="mb-1">Product Management</h6>
                            <small>Keep your products organized</small>
                        </div>
                        <span>✓</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 feature-yellow">
                        <div>
                            <h6 class="mb-1">Warranty Tracking</h6>
                            <small>Stay informed about warranty periods</small>
                        </div>
                        <span>✓</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 feature-lavender">
                        <div>
                            <h6 class="mb-1">Expiry Monitoring</h6>
                            <small>Keep track of important expiry dates</small>
                        </div>
                        <span>✓</span>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
