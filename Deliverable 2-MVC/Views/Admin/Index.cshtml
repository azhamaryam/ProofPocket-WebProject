@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="welcome-text">
    <h2>Admin Dashboard</h2>
    <p>Manage users, product categories and system information.</p>
</div>

<!-- Statistics -->
<div class="row g-4">

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <h6>Registered Users</h6>
            <h2>@Model.RegisteredUsers</h2>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <h6>Product Categories</h6>
            <h2>@Model.ProductCategories</h2>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <h6>Total Products</h6>
            <h2>@Model.TotalProducts</h2>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <h6>Total Warranties</h6>
            <h2>@Model.TotalWarranties</h2>
        </div>
    </div>

</div>

<!-- Registered Users -->
<div class="section-card" id="users">

    <h4 class="section-title">Registered Users</h4>

    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Registration Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Users.Any())
                {
                    foreach (var u in Model.Users)
                    {
                        <tr>
                            <td title="@u.Id">@(u.Id.Length > 8 ? u.Id.Substring(0, 8) : u.Id)</td>
                            <td>@u.FullName</td>
                            <td>@u.Email</td>
                            <td>@u.RegistrationDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this user and all of their products?');">
                                    <button type="submit" class="btn-action btn-action-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-message">
                            No registered users yet.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

<!-- Product Categories -->
<div class="section-card" id="categories">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">

        <h4 class="section-title mb-0">Product Categories</h4>

        <button class="add-btn" type="button" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            + Add Category
        </button>

    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Category ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Categories.Any())
                {
                    foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(c.Description) ? "—" : c.Description)</td>
                            <td class="text-nowrap">
                                <a asp-action="EditCategory" asp-route-id="@c.Id" class="btn-action">Edit</a>
                                <form asp-action="DeleteCategory" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    <button type="submit" class="btn-action btn-action-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-message">
                            No product categories added yet.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="AddCategory" method="post">

                <div class="modal-header">
                    <h5 class="modal-title" id="addCategoryTitle">Add Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="catName" class="form-label">Category Name</label>
                        <input type="text" id="catName" name="Name" class="form-control" maxlength="100" required placeholder="Enter category name">
                    </div>

                    <div>
                        <label for="catDescription" class="form-label">Description</label>
                        <textarea id="catDescription" name="Description" class="form-control" rows="3" maxlength="300" placeholder="Enter a short description"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Category</button>
                </div>

            </form>

        </div>
    </div>
</div>
